  "scripts": {
    "start": "react-scripts start",
    "prebuild": "node -e \"const fs=require('fs');const v=fs.readFileSync('src/iron-realm.jsx','utf8').match(/APP_VERSION\\s*=\\s*\\\"([^\\\"]+)\\\"/)[1];fs.writeFileSync('public/version.json',JSON.stringify({version:v})+'\\n');console.log('version.json →',v)\"",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
