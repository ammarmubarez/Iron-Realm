# Committed build defaults (no secrets here — real keys go in .env.local).
# Keep the webpack runtime out of index.html so the production CSP can use
# script-src 'self' with no inline scripts.
INLINE_RUNTIME_CHUNK=false
# Source maps expose the full source to anyone who opens devtools on the
# deployed site; the repo is public anyway, but they double the download.
GENERATE_SOURCEMAP=false
